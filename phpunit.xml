<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

		<env name="DB_CONNECTION" value="mysql"/>
		<env name="DB_HOST" value="127.0.0.1"/>
		<env name="DB_PORT" value="3306"/>
		<env name="DB_DATABASE" value="chippytrip_api_testing"/>
		<!-- DB_USERNAME/DB_PASSWORD come from .env.testing (CI sets its own). -->

		<!-- Dummy values so tests run without .env/.env.testing (e.g. in CI).
		     All outbound HTTP is faked; tests match on these paths, not hosts. -->
		<env name="APP_KEY" value="base64:Y2hpcHB5dHJpcC10ZXN0LWtleS1ub3Qtc2VjcmV0ISE="/>
		<env name="FLIGHTAWARE_URL" value="https://flightaware.test"/>
		<env name="FLIGHTAWARE_CALLBACK" value="https://chippytrip.test/flightaware/callback"/>
		<env name="FLIGHTAWARE_KEY" value="test"/>
		<env name="FLIGHTSERVICE_URL" value="https://flightservice.test"/>
		<env name="FLIGHTSERVICE_HOST" value="flightservice.test"/>
		<env name="FLIGHTSERVICE_KEY" value="test"/>
		<env name="TIMEZONE_BASE_URL" value="https://timezonedb.test"/>
		<env name="TIMEZONE_KEY" value="test"/>
		<env name="AIRLABS_URL" value="https://airlabs.test"/>
		<env name="AVIATIONEDGE_URL" value="https://aviationedge.test"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
